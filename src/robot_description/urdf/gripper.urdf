      </material>
    </visual>
    <collision>
      <origin xyz="0.0791474 0.180024 0.128211" rpy="-3.14159 -0 -0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/gripper_pinion_collision.stl" />
      </geometry>
    </collision>
  </link>
  
  <joint name="gripper" type="revolute">
    <origin xyz="-0.0791474 0.180024 0.128211" rpy="3.14159 -0 -0" />
    <parent link="tool_mounting_plate" />
    <child link="gripper_pinion" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-3.14159" upper="0" />
  </joint>
  
  <joint name="base_link_to_tool_mounting_plate" type="fixed">
    <origin xyz="0 0 0" rpy="0 -0 0" />
    <parent link="base_link" />
    <child link="tool_mounting_plate" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" />
  </joint>
  
  <link name="gripper_slider">
