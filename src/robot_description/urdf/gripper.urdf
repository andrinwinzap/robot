<robot name="gripper">
  
  <link name="base_link" />
<link name="tool_mounting_plate">
    <inertial>
      <origin xyz="-0.080077 0.180021 0.0971925" rpy="0 0 0" />
      <mass value="0.0326621" />
      <inertia ixx="1.37113e-05" ixy="6.31e-10" ixz="-9.5087e-08" iyy="1.4848e-05" iyz="-5.26e-10" izz="1.94271e-05" />
    </inertial>
    
    <visual>
      <origin xyz="-0.080077 0.180021 0.0971925" rpy="0 -0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/tool_mounting_plate_visual.stl" />
      </geometry>
      <material name="tool_mounting_plate_parts_material">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.080077 0.180021 0.0971925" rpy="0 -0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/tool_mounting_plate_collision.stl" />
      </geometry>
    </collision>
  </link>
  
  <link name="gripper_pinion">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-09" />
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
    </inertial>
    
    <visual>
      <origin xyz="0.0791474 0.180024 0.128211" rpy="-3.14159 -0 -0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/gripper_pinion_visual.stl" />
      </geometry>
      <material name="gripper_pinion_parts_material">
